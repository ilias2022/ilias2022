<h1>Match History</h1>

<div style="display: flex; gap: 12px; margin-bottom: 20px; align-items: center;">
  <%= form_tag matches_path, method: :get, style: "display: flex; gap: 8px;" do %>
    <%= select_tag :season, options_for_select((2008..Time.current.year).map { |y| [y, y] }.reverse, params[:season]),
        include_blank: "All seasons" %>
    <%= submit_tag "Filter", class: "btn btn-secondary", style: "width: auto; padding: 10px 16px;" %>
  <% end %>
  <%= link_to "Add Match", new_match_path, class: "btn btn-primary" %>
</div>

<div class="card">
  <% if @matches.empty? %>
    <p style="color: #a0a0c0;">No matches recorded. <%= link_to "Add one →", new_match_path, style: "color: #f97316;" %></p>
  <% else %>
    <table>
      <thead>
        <tr><th>Date</th><th>Season</th><th>Team 1</th><th>Team 2</th><th>Venue</th><th>Winner</th></tr>
      </thead>
      <tbody>
        <% @matches.each do |match| %>
          <tr>
            <td style="color: #a0a0c0;"><%= match.match_date&.strftime("%d %b %Y") || "—" %></td>
            <td><%= match.season || "—" %></td>
            <td><%= match.team1.short_name %></td>
            <td><%= match.team2.short_name %></td>
            <td style="color: #a0a0c0;"><%= match.venue || "—" %></td>
            <td style="color: #f97316; font-weight: 700;"><%= match.winner&.short_name || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
