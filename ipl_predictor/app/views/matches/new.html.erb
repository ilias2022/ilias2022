<h1>Record a Match</h1>

<div class="card">
  <%= form_with model: @match, url: matches_path do |f| %>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
      <div class="form-group">
        <label>Team 1</label>
        <%= f.collection_select :team1_id, @teams, :id, :name, { include_blank: "Select..." } %>
      </div>
      <div class="form-group">
        <label>Team 2</label>
        <%= f.collection_select :team2_id, @teams, :id, :name, { include_blank: "Select..." } %>
      </div>
      <div class="form-group">
        <label>Winner</label>
        <%= f.collection_select :winner_id, @teams, :id, :name, { include_blank: "Select..." } %>
      </div>
      <div class="form-group">
        <label>Season</label>
        <%= f.number_field :season, placeholder: "e.g. 2026", min: 2008, max: 2030 %>
      </div>
      <div class="form-group">
        <label>Match Date</label>
        <%= f.date_field :match_date %>
      </div>
      <div class="form-group">
        <label>Venue</label>
        <%= f.text_field :venue, placeholder: "e.g. Eden Gardens, Kolkata" %>
      </div>
      <div class="form-group">
        <label>Toss Winner</label>
        <%= f.collection_select :toss_winner_id, @teams, :id, :name, { include_blank: "Select..." } %>
      </div>
      <div class="form-group">
        <label>Toss Decision</label>
        <%= f.select :toss_decision, [["Bat", "bat"], ["Field", "field"]], { include_blank: "Select..." } %>
      </div>
    </div>

    <% if @match.errors.any? %>
      <div class="alert alert-danger">
        <% @match.errors.full_messages.each do |msg| %>
          <p><%= msg %></p>
        <% end %>
      </div>
    <% end %>

    <%= f.submit "Save Match", class: "btn btn-primary" %>
    <%= link_to "Cancel", matches_path, class: "btn btn-secondary", style: "margin-left: 8px;" %>
  <% end %>
</div>
