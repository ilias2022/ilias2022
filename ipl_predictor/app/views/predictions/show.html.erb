<h1>Match Prediction</h1>

<div class="card">
  <div style="display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; margin-bottom: 24px;">
    <div style="text-align: center;">
      <div style="font-size: 22px; font-weight: 800; color: <%= @prediction.predicted_winner == @prediction.team1 ? '#f97316' : '#a0a0c0' %>">
        <%= @prediction.team1.name %>
        <% if @prediction.predicted_winner == @prediction.team1 %>
          <span style="font-size: 14px;">★ Predicted winner</span>
        <% end %>
      </div>
      <div style="font-size: 36px; font-weight: 900; color: #f97316; margin-top: 8px;">
        <%= @prediction.team1_pct %>%
      </div>
      <div class="prob-bar">
        <div class="prob-fill" style="width: <%= @prediction.team1_pct %>%; background: #f97316;"></div>
      </div>
    </div>
    <div style="color: #666; font-weight: 700; font-size: 20px;">VS</div>
    <div style="text-align: center;">
      <div style="font-size: 22px; font-weight: 800; color: <%= @prediction.predicted_winner == @prediction.team2 ? '#f97316' : '#a0a0c0' %>">
        <%= @prediction.team2.name %>
        <% if @prediction.predicted_winner == @prediction.team2 %>
          <span style="font-size: 14px;">★ Predicted winner</span>
        <% end %>
      </div>
      <div style="font-size: 36px; font-weight: 900; color: #3b82f6; margin-top: 8px;">
        <%= @prediction.team2_pct %>%
      </div>
      <div class="prob-bar">
        <div class="prob-fill" style="width: <%= @prediction.team2_pct %>%; background: #3b82f6;"></div>
      </div>
    </div>
  </div>

  <% if @prediction.venue.present? %>
    <p style="color: #a0a0c0; text-align: center; margin-bottom: 16px;">📍 <%= @prediction.venue %></p>
  <% end %>

  <h2>Score Breakdown</h2>
  <table>
    <thead>
      <tr>
        <th>Factor</th>
        <th style="color: #f97316;"><%= @prediction.team1.short_name %> contribution (%)</th>
        <th style="color: #3b82f6;"><%= @prediction.team2.short_name %> contribution (%)</th>
      </tr>
    </thead>
    <tbody>
      <% @breakdown[:team1].each do |factor, val| %>
        <tr>
          <td><%= factor.to_s.humanize %></td>
          <td style="color: #f97316;"><%= val %></td>
          <td style="color: #3b82f6;"><%= @breakdown[:team2][factor] %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<div style="display: flex; gap: 12px; margin-bottom: 12px;">
  <%= link_to "Predict Another", new_prediction_path, class: "btn btn-primary" %>
  <%= link_to "All Predictions", predictions_path, class: "btn btn-secondary" %>
</div>

<div class="disclaimer">
  ⚠️ This prediction is purely statistical and for entertainment purposes. Always gamble responsibly and within your means.
</div>
