<h1>IPL Teams</h1>

<div class="card">
  <table>
    <thead>
      <tr>
        <th>Team</th>
        <th>Code</th>
        <th>Titles</th>
        <th>Matches</th>
        <th>Wins</th>
        <th>Win Rate</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @teams.each do |team| %>
        <tr>
          <td><strong><%= team.name %></strong></td>
          <td style="color: #f97316;"><%= team.short_name %></td>
          <td><%= "🏆" * (team.titles || 0) %><%= team.titles.zero? ? "—" : "" %></td>
          <td><%= team.total_matches %></td>
          <td><%= team.wins.count %></td>
          <td>
            <span style="color: <%= team.win_rate >= 0.55 ? '#2ecc71' : team.win_rate >= 0.45 ? '#f97316' : '#e74c3c' %>">
              <%= (team.win_rate * 100).round(1) %>%
            </span>
          </td>
          <td><%= link_to "Details →", team_path(team), style: "color: #f97316;" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
