<h1><%= @team.name %> <span style="font-size: 16px; color: #a0a0c0;">(<%= @team.short_name %>)</span></h1>

<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 20px;">
  <div class="card" style="text-align: center; padding: 16px;">
    <div style="font-size: 28px; font-weight: 900; color: #f97316;"><%= @team.titles || 0 %></div>
    <div style="color: #a0a0c0; font-size: 12px; text-transform: uppercase;">Titles</div>
  </div>
  <div class="card" style="text-align: center; padding: 16px;">
    <div style="font-size: 28px; font-weight: 900; color: #f97316;"><%= @team.total_matches %></div>
    <div style="color: #a0a0c0; font-size: 12px; text-transform: uppercase;">Matches</div>
  </div>
  <div class="card" style="text-align: center; padding: 16px;">
    <div style="font-size: 28px; font-weight: 900; color: #2ecc71;"><%= @team.wins.count %></div>
    <div style="color: #a0a0c0; font-size: 12px; text-transform: uppercase;">Wins</div>
  </div>
  <div class="card" style="text-align: center; padding: 16px;">
    <div style="font-size: 28px; font-weight: 900; color: #3b82f6;"><%= (@team.win_rate * 100).round(1) %>%</div>
    <div style="color: #a0a0c0; font-size: 12px; text-transform: uppercase;">Win Rate</div>
  </div>
</div>

<% if @team.home_ground.present? %>
  <p style="color: #a0a0c0; margin-bottom: 20px;">📍 Home: <%= @team.home_ground %></p>
<% end %>

<div class="card">
  <h2>Recent Matches</h2>
  <% if @recent_matches.empty? %>
    <p style="color: #a0a0c0;">No matches recorded yet.</p>
  <% else %>
    <table>
      <thead>
        <tr><th>Date</th><th>Opponent</th><th>Venue</th><th>Result</th></tr>
      </thead>
      <tbody>
        <% @recent_matches.each do |match| %>
          <% opponent = match.team1 == @team ? match.team2 : match.team1 %>
          <tr>
            <td style="color: #a0a0c0;"><%= match.match_date&.strftime("%d %b %Y") || "—" %></td>
            <td><%= opponent.name %></td>
            <td style="color: #a0a0c0;"><%= match.venue || "—" %></td>
            <td>
              <% if match.winner == @team %>
                <span style="color: #2ecc71; font-weight: 700;">Won</span>
              <% elsif match.winner.present? %>
                <span style="color: #e74c3c; font-weight: 700;">Lost</span>
              <% else %>
                <span style="color: #a0a0c0;">—</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
